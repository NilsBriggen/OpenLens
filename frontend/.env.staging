# OpenLens Frontend - Staging Environment

# API Configuration
REACT_APP_API_URL=https://staging-api.openlens.example.com
REACT_APP_WS_URL=wss://staging-api.openlens.example.com

# App Configuration
REACT_APP_ENV=staging
REACT_APP_VERSION=7.0.0
REACT_APP_NAME=OpenLens (Staging)

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AI=true
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_SCRAPING=true
REACT_APP_ENABLE_THREAT_INTEL=true

# Debug
REACT_APP_DEBUG=true
